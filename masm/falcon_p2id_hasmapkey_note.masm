#! Same as falcon_p2id_note.masm but uses adv.has_mapkey to check
#! for the signature in the advice map before reading it.
#! This matches the pattern in the AgentDebitNote script.

use miden::protocol::active_note
use miden::protocol::note
use miden::protocol::output_note
use miden::core::sys
use miden::core::crypto::dsa::falcon512_poseidon2
use miden::core::crypto::hashes::poseidon2
use miden::standards::wallets::basic->wallet
use miden::standards::notes::p2id

const STORAGE_PTR=100
const AGENT_PK_PTR=100
const TARGET_SUFFIX_PTR=104
const TARGET_PREFIX_PTR=105
const AMOUNT_PTR=8
const ASSET_KEY_PTR=12
const ASSET_VALUE_PTR=16

@note_script
pub proc main
    mem_store.AMOUNT_PTR
    drop drop drop

    push.STORAGE_PTR exec.active_note::get_storage
    drop drop

    # ── 1. Compute MESSAGE = merge(serial_num, [amount, 0, 0, 0]) ──
    push.0.0.0 mem_load.AMOUNT_PTR
    exec.active_note::get_serial_number
    exec.poseidon2::merge
    # => [MESSAGE]

    # ── 2. Verify AGENT Falcon signature ──
    # Uses adv.has_mapkey to check if sig is in advice map.
    # This is the pattern that may differ from direct adv.push_mapval.

    padw push.AGENT_PK_PTR mem_loadw_le
    # => [AGENT_PK, MESSAGE]

    dupw.1 dupw.1
    exec.poseidon2::merge
    # => [SIG_KEY, AGENT_PK, MESSAGE]

    # Check if the key exists in the advice map
    adv.has_mapkey
    # => [SIG_KEY, AGENT_PK, MESSAGE]
    adv_push.1
    # => [has_sig, SIG_KEY, AGENT_PK, MESSAGE]

    if.true
        adv.push_mapval
        dropw
    else
        dropw
    end

    exec.falcon512_poseidon2::verify
    # => []

    # ── 3. Add assets to wallet ──
    exec.wallet::add_assets_to_account
    push.ASSET_KEY_PTR exec.active_note::get_assets drop drop

    # ── 4. Create P2ID output note ──
    exec.active_note::get_serial_number
    swap.3 push.1 add swap.3
    push.1 push.0
    mem_load.TARGET_PREFIX_PTR mem_load.TARGET_SUFFIX_PTR
    exec.p2id::new

    push.0.0.0 mem_load.AMOUNT_PTR
    padw push.ASSET_KEY_PTR mem_loadw_le
    call.wallet::move_asset_to_note
    dropw dropw dropw dropw

    exec.sys::truncate_stack
end
