#! Minimal custom note that checks a secret hash before releasing assets.
#!
#! This is a simplified version of the pattern from the Miden docs custom note
#! tutorial. The note stores an expected digest in its storage. The consumer
#! must pass the secret (preimage) as note_args. The note hashes the args,
#! compares against the stored digest, and if they match, adds assets to the
#! consuming wallet.
#!
#! Note storage (4 items at EXPECTED_DIGEST_PTR):
#!   [0-3]  expected_digest (Word) = hash of the secret
#!
#! Note args:
#!   [secret_0, secret_1, secret_2, secret_3]  — the preimage
#!
#! This script works perfectly in MockChain but fails with StackReadFailed
#! when consumed via miden-client against testnet.

use miden::protocol::active_note
use miden::standards::wallets::basic->wallet

const EXPECTED_DIGEST_PTR=0
const ERROR_DIGEST_MISMATCH="Expected digest does not match computed digest"

@note_script
pub proc main
    # note_args are on the operand stack: [arg3, arg2, arg1, arg0, ...]
    # Hash the note_args to get the computed digest
    hash
    # => [COMPUTED_DIGEST, ...]

    # Load the expected digest from note storage
    push.EXPECTED_DIGEST_PTR exec.active_note::get_storage drop drop
    # => [COMPUTED_DIGEST, ...]
    # Note storage is now in memory at EXPECTED_DIGEST_PTR

    # Load expected digest from memory
    padw push.EXPECTED_DIGEST_PTR mem_loadw_le
    # => [EXPECTED_DIGEST, COMPUTED_DIGEST, ...]

    # Compare
    assert_eqw.err=ERROR_DIGEST_MISMATCH
    # => [...]

    # Release assets to the consuming wallet
    exec.wallet::add_assets_to_account
end
