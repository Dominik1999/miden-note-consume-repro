#! Custom note with Falcon signature verification + P2ID output note.
#!
#! This reproduces the full pattern used in AgentDebitNote:
#!   1. Load storage (agent PK commitment)
#!   2. Compute message from serial_num + note_args
#!   3. Verify Falcon-512 signature (from advice map)
#!   4. Add assets to wallet
#!   5. Create P2ID output note to a target account
#!   6. Move assets to the output note
#!
#! Note storage (6 items at STORAGE_PTR):
#!   [0-3]  agent_pubkey_commitment (Word)
#!   [4]    target_account_id_suffix (P2ID recipient)
#!   [5]    target_account_id_prefix
#!
#! Note args: [amount, 0, 0, 0]
#!
#! Advice map: { merge(AGENT_PK, MESSAGE): [PREPARED_FALCON_SIG] }

use miden::protocol::active_note
use miden::protocol::note
use miden::protocol::output_note
use miden::core::sys
use miden::core::crypto::dsa::falcon512_poseidon2
use miden::core::crypto::hashes::poseidon2
use miden::standards::wallets::basic->wallet
use miden::standards::notes::p2id

# ── Memory layout ──

const STORAGE_PTR=100
const AGENT_PK_PTR=100
const TARGET_SUFFIX_PTR=104
const TARGET_PREFIX_PTR=105

const AMOUNT_PTR=8

const ASSET_KEY_PTR=12
const ASSET_VALUE_PTR=16

# ── Entry point ──

@note_script
pub proc main
    # Note args on stack: [arg3, arg2, arg1, arg0]
    # arg0 = amount, rest = 0
    mem_store.AMOUNT_PTR
    drop drop drop

    # Load note storage into memory at STORAGE_PTR
    push.STORAGE_PTR exec.active_note::get_storage
    # => [num_items, dest_ptr]
    drop drop

    # ── 1. Compute MESSAGE = merge(serial_num, [amount, 0, 0, 0]) ──
    push.0.0.0 mem_load.AMOUNT_PTR
    exec.active_note::get_serial_number
    exec.poseidon2::merge
    # => [MESSAGE]

    # ── 2. Verify AGENT Falcon signature from advice map ──
    padw push.AGENT_PK_PTR mem_loadw_le
    # => [AGENT_PK, MESSAGE]

    # Compute map key = merge(AGENT_PK, MESSAGE)
    dupw.1 dupw.1
    # => [AGENT_PK, MESSAGE, AGENT_PK, MESSAGE]
    exec.poseidon2::merge
    # => [SIG_KEY, AGENT_PK, MESSAGE]

    # Push signature from advice map to advice stack
    adv.push_mapval
    # => [SIG_KEY, AGENT_PK, MESSAGE]
    # AS => [PREPARED_SIG]
    dropw
    # => [AGENT_PK, MESSAGE]

    exec.falcon512_poseidon2::verify
    # => []

    # ── 3. Add assets to wallet ──
    exec.wallet::add_assets_to_account
    push.ASSET_KEY_PTR exec.active_note::get_assets drop drop

    # ── 4. Create P2ID output note to target ──
    exec.active_note::get_serial_number
    swap.3 push.1 add swap.3
    push.1 push.0
    mem_load.TARGET_PREFIX_PTR mem_load.TARGET_SUFFIX_PTR
    exec.p2id::new

    # ── 5. Move assets to the P2ID note ──
    push.0.0.0 mem_load.AMOUNT_PTR
    padw push.ASSET_KEY_PTR mem_loadw_le
    call.wallet::move_asset_to_note
    dropw dropw dropw dropw

    exec.sys::truncate_stack
end
